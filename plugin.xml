<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<plugin xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Severino/Spacialist/refs/heads/0.12-feat-plugin-xml-schema/schemas/plugin-xml/v1/schema.xsd">
    <name>Coordinates</name>
    <title>Coordinates to Geometry</title>
    <description>Calculates a WKT attribute from easting, northing and SRID attributes of the same entity type.</description>
    <version>1.0.0</version>
    <licence>MIT</licence>
    <authors>
        <author>Severin Opel</author>
    </authors>
    <routes src="routes/api.php" middleware="api"/>
    <migrations src="migrations"/>
    <permissions src="permissions.json"/>
    <listeners>
        <listener on="attribute_value.saved" src="Listeners/GeometrySync@onSaved"/>
        <listener on="attribute_value.deleted" src="Listeners/GeometrySync@onDeleted"/>
        <listener on="entity_type.attribute_removed" src="Listeners/GeometrySync@onAttributeRemoved"/>
    </listeners>
</plugin>
